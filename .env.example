# Copy to .env. Everything is optional except where noted.

# Claude API key. Without it the assistant falls back to the rule-based parser (still works, lower confidence).
ANTHROPIC_API_KEY=
# Model used to turn natural language into search filters. See docs/DECISIONS.md for the trade-off.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Elasticsearch (docker compose sets this for the app container)
ES_URL=http://localhost:9200
# Public Kibana URL, linked from /admin
KIBANA_URL=http://localhost:5601

PORT=3000
# Shift sample departure dates so they're relative to today (the export is from 2026-10-16)
SHIFT_DATES=true
