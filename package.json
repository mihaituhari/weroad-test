{
  "name": "weroad-trip-assistant",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "seed": "node --env-file-if-exists=.env src/server/seed.ts --force",
    "eval": "node --env-file-if-exists=.env eval/run.ts",
    "test": "TZ=UTC vitest run",
    "typecheck": "tsc --noEmit",
    "es:up": "docker compose up -d elasticsearch kibana"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@elastic/elasticsearch": "9.5.1",
    "@hono/node-server": "2.1.11",
    "@huggingface/transformers": "4.3.2",
    "hono": "4.13.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
